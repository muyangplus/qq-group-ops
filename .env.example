# ============================================================
# QQ Group Ops 配置模板
#
#   · 逐项说明（取值 / 默认值 / 改完什么时候生效）见 docs/CONFIGURATION.md
#   · 本文件只放**必须留在进程环境里**的项，每一组都写了「为什么必须在这里」；
#     真实凭据 / 域名 / 密钥请写在 `.env`（不要提交）
#   · **热改项不在这里**（保留期 / 周期 / 部署监测 / 定时发言 / 管理后台会话与限流等）：
#     它们的默认值在代码里，改法见文件末尾「热改项：不要写在这里」一节
# ============================================================

# ============================================================
# 1. QQ 官方开放平台机器人（必填）
#   为什么必须在这里：机器人凭据，启动就要用来换 access token。
# ============================================================
# 开放平台 → 机器人 → 开发设置里的 AppID 与 Client Secret
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
# 可选：已有 access token 时直接填；留空则自动获取并缓存（未过期会复用）
QQ_BOT_TOKEN=
# 为什么必须在这里：决定连的是沙箱还是正式环境，属于「启动期形态」。
# 是否使用沙箱环境（开放平台提供时才有意义）
QQ_BOT_SANDBOX=false

# ============================================================
# 2. 事件通道（两条通道**二选一**）
#   为什么必须在这里：进程要监听哪个端口 / 用哪种接入方式，启动前就要定；
#   这是「形态」不是「运行期参数」，也不可能存在数据库里（连库之前就要用）。
# ============================================================
# websocket = 官方长连接（默认，不需要公网入口）；webhook = 官方回调推到本服务。
# 同时开启会把同一条事件消费两次，别这么干。
EVENT_MODE=websocket
# 以下 4 项只在 EVENT_MODE=webhook 时生效：
# 监听端口（反向代理通常把 443 转发到这里）
WEBHOOK_PORT=8786
# 监听地址（默认只允许本机反向代理访问；要直接暴露才改 0.0.0.0）
WEBHOOK_HOST=127.0.0.1
# 回调路径（必须与开放平台后台填写的完全一致）
WEBHOOK_PATH=/webhook/qq
# 回调签名密钥（Ed25519 种子）；留空会回落到 QQ_BOT_CLIENT_SECRET
WEBHOOK_SECRET=

# ============================================================
# 3. 权限（超管种子）
#   为什么必须在这里：它是「第一次启动、库里还没有任何超管」时的引导；
#   之后请用 `/perm` 管理（后台「权限」页也能改），改这里不再生效。
# ============================================================
# 全局超级管理员的 userId（官方 OpenID，**不是 QQ 号**），多个用逗号分隔。
ADMIN_USER_IDS=

# ============================================================
# 4. 数据库
#   为什么必须在这里：连库之前当然要先知道库在哪（启动引导）。
# ============================================================
# SQLite 数据文件；所在目录会自动创建
SQLITE_PATH=data/qq-group-ops.db
# 想改用 PostgreSQL：取消下面两行注释（本地可先 `pnpm db:up`）。
# DATABASE_URL 一旦设置就**优先于 SQLITE_PATH**。
# DATABASE_URL=postgres://qqbot:change-me@localhost:5432/qq_group_ops
# POSTGRES_PASSWORD=change-me
# 其它写法：
# DATABASE_URL=sqlite:./data/qq-group-ops.db   显式指定 SQLite 文件
# DATABASE_URL=sqlite::memory:                 纯内存，重启即丢，仅调试用

# ============================================================
# 5. 本地路径
#   为什么必须在这里：文件路径属于「这台机器上的形态」，且读它的时候还没有配置存储。
# ============================================================
# 班级索引文件；由 `pnpm class:index` 从 data/class.json 生成
CLASS_INDEX_FILE=data/class-index.json
# 仅 `pnpm class:index` 使用：JSON + SQLite 双产物的 SQLite 路径（设为 - 表示跳过）
# CLASS_INDEX_SQLITE_FILE=data/class-index.sqlite
# access token 与网关地址的缓存文件；留空 = 只缓存在内存（重启后重新获取）
QQ_BOT_CACHE_FILE=data/qq-bot-cache.json

# ============================================================
# 6. 日志与时区
#   为什么必须在这里：日志要在最早期就能用（配置存储还没读出来时也要打日志），
#   时区还要给日志时间戳定调。
# ============================================================
# debug / info / warn / error
LOG_LEVEL=info
# 日志文件路径；留空 = 关闭文件日志
LOG_FILE=logs/qq-group-ops.log
# 是否同时输出到控制台
LOG_CONSOLE=true
# 彩色输出：auto / always / never
LOG_COLOR=auto
# 卡片时间与日志时间的时区（库里始终存 UTC）；非法值会回落默认并打 warn。
# 也可以在 /config 里热改这一项（这里给的是启动默认值）。
TZ=Asia/Shanghai

# ============================================================
# 7. 管理 API（可选；默认关闭）
#   为什么必须在这里：只监听回环地址 + 会话密钥这类是**核心安全项**，
#   密钥 / 端口 / 开关一律不进运行时可改的配置面板（改了要重启，这是设计）。
# ============================================================
# 认证 = 「机器人私信一次性令牌 + 会话 cookie」（详见 docs/ADMIN-API.md）：
#   ① 管理员私信机器人 /admin login（或服务器上执行 `pnpm admin:token`）→ 拿到一次性令牌
#   ② 浏览器打开 <ADMIN_API_PUBLIC_BASE_URL>/login?token=…（链接点不动就手工粘贴令牌）
#   ③ 服务端兑换令牌 → 种会话 cookie（HttpOnly + SameSite=Strict）
#
# **想开启**（本组默认全部注释掉）：去掉 ADMIN_API_ENABLED / HOST / PORT / SESSION_SECRET
# 这几行的注释，SESSION_SECRET 用下面命令生成一个 ≥32 字符的随机串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 想让登录链接能直接点开，还要填 ADMIN_API_PUBLIC_BASE_URL；前面挂了 TLS 反代后
# 再把 ADMIN_API_COOKIE_SECURE 改成 true。
#
# 特性：随机器人一起起停，不占 webhook 端口、也不需要第二个进程单元；只监听回环地址，
# 对外必须经反向代理；这些是**核心安全项**，只从环境变量读，不进 /config。
# 部署与排障见 docs/OPERATIONS.md 的「管理 API」一节。
#
# 总开关（false = 完全不监听任何端口）
# ADMIN_API_ENABLED=false
# 监听地址（默认 127.0.0.1，只给本机反向代理；要对外必须显式改并挂 TLS）
# ADMIN_API_HOST=127.0.0.1
# 监听端口。**同一个端口只能有一个入口**：机器人进程内的监听口（读写）与
# 「pnpm admin:api」只读巡检进程都用它；想同时开两个，就给巡检换一个（例如 8788）
# ADMIN_API_PORT=8787
# 会话 cookie 的 HMAC 密钥（≥32 字符；换掉它 = 所有会话立即失效；开启时必填，缺了拒绝启动）
# ADMIN_API_SESSION_SECRET=
# 反代终止 TLS 时设 true（给 cookie 加 Secure）
# ADMIN_API_COOKIE_SECURE=false
# 浏览器能访问到的管理面地址（留空 = /admin login 只给令牌，需要手工粘贴）
# ADMIN_API_PUBLIC_BASE_URL=https://ops.example.com
# 管理前台静态资源目录：**默认 web/dist 由管理 API 自己托管**（`/`、`/login` 等页面），
# 于是反向代理「整个域名 → 8787」就够了；目录不存在时自动跳过（不影响接口）。
# 想改由 nginx 托管（`root` + `try_files`）就把这一行设成空值：ADMIN_API_WEB_DIR=
# ADMIN_API_WEB_DIR=web/dist
# 额外收窄可签发令牌的人（留空 = 所有平台超管 240 都能签发）
# ADMIN_API_ALLOWED_OPENIDS=
# 机器调用用的长期令牌（给 CI / 脚本，与一次性登录令牌分开）：
# 格式 token:scope1|scope2[@到期ISO时间]，多个用逗号分隔。
# scope：*（全部）/ read / write（该族全部），或按域细分 read:<域> / write:<域>
# （域见 src/adminApi/scopes.ts，例：read:join、read:audit、write:activity、write:notify）。
# 注意：细粒度令牌访问**未登记的端点**会被拒（fail-closed）—— 新端点要么登记、要么给粗粒度 scope。
# 例：ADMIN_API_TOKENS=abcdef0123456789:read:join,abcdef9876543210:write:activity@2027-01-01T00:00:00Z
# ADMIN_API_TOKENS=

# ============================================================
# 热改项：**不要写在这里**
# ============================================================
# 下面这些项已经搬进系统配置（`platform_settings` 表），改法有两个，都**立即生效、不用重启**：
#   · 私信机器人：/config set <项> <值>（只有全局超管、只能在私信里）
#   · 管理后台 →「配置」页（同一套存储、同一条校验）
#
# `.env` 里**写了**这些键会怎样：升级到 0.29.0 后的**第一次启动**会把它们导入库一次
# （保证行为不漂移），之后这里再改也不会生效 —— 一切以库为准。
# 想让某一项回到内置默认值：`/config clear <项>`。
# 迁移与备份怎么走见 docs/OPERATIONS.md「配置搬家」一节。
#
#   保留期（-1 = 永久，0 = 关闭该能力，正整数 = 天数）
#     RAW_MESSAGE_RETENTION_DAYS / AUDIT_LOG_RETENTION_DAYS / JOIN_REQUEST_TTL_DAYS
#   首次交互菜单推送（memory / persistent）
#     MENU_FIRST_PUSH
#   活动通知额度与统计图片字体地址
#     ACTIVITY_NOTIFY_DAILY_LIMIT / ACTIVITY_NOTIFY_RATE_PER_SECOND
#     ACTIVITY_STATS_FONT_URL
#   申诉超时轮转（分钟）
#     APPEAL_HOLD_MINUTES
#   计时（毫秒；0 = 关闭）
#     SCAN_INTERVAL_MS / JOIN_SYNC_INTERVAL_MS
#   部署监测（0 = 关闭 / AUTO_RESTART_ON_DEPLOY=off 时照样提醒、只是不自动重启）
#     AUTO_RESTART_ON_DEPLOY / DEPLOY_RESTART_DELAY_MINUTES / DEPLOY_CHECK_INTERVAL_MS
#   机器人定时发言（默认关；开了之后各群还要 /announce on）
#     SCHEDULED_ANNOUNCE_ENABLED / SCHEDULED_ANNOUNCE_HOURLY_LIMIT
#   管理后台会话 / 令牌 / 限流（分钟 / 分钟 / 每分钟次数，0 = 不限）
#     ADMIN_API_SESSION_TTL_MINUTES / ADMIN_API_TOKEN_TTL_MINUTES
#     ADMIN_API_RATE_LIMIT_PER_MINUTE

# ============================================================
# 预留（当前版本尚未使用，填了不生效）
# ============================================================
# 内容安全 API（官方开放相应权限后再接）
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_API_KEY=

# AI 辅助审核（暂未实现）
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
