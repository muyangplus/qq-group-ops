# ============================================================
# QQ Group Ops 配置模板
#
# 用法：
#   1. 复制为 .env
#      cp .env.example .env
#   2. 按下面注释填写
#   3. 不要把 .env 提交到 Git
# ============================================================

# ------------------------------------------------------------
# 1. QQ 官方开放平台机器人（必填）
# ------------------------------------------------------------
# 在 QQ 开放平台创建机器人后获取
QQ_BOT_APP_ID=
# 机器人 Client Secret
QQ_BOT_CLIENT_SECRET=
# 可选：已有 access token 时填写；留空则自动获取
QQ_BOT_TOKEN=
# 是否使用沙箱环境（如开放平台提供）
QQ_BOT_SANDBOX=false

# ------------------------------------------------------------
# 2. Phase 0 验证（运行 pnpm phase0 时需要）
# ------------------------------------------------------------
# 测试群 openid，不是普通群号；按官方文档获取
QQ_BOT_TEST_GROUP_ID=
# true 时会发送一条测试消息并尝试撤回
PHASE0_SEND_TEST_MESSAGE=false

# ------------------------------------------------------------
# 3. 权限
# ------------------------------------------------------------
# 超级管理员 QQ 号，逗号分隔
ADMIN_QQ_IDS=

# ------------------------------------------------------------
# 4. 数据库
# ------------------------------------------------------------
# 生产使用 PostgreSQL
DATABASE_URL=postgres://qqbot:change-me@localhost:5432/qq_group_ops

# ------------------------------------------------------------
# 5. 日志
# ------------------------------------------------------------
# debug / info / warn / error
LOG_LEVEL=info

# ------------------------------------------------------------
# 6. 数据保留
# ------------------------------------------------------------
# 0 表示不保存消息原文；如需短期追溯可设为 3-7
RAW_MESSAGE_RETENTION_DAYS=0
# 审计日志保留天数
AUDIT_LOG_RETENTION_DAYS=180

# ============================================================
# 以下为后续阶段预留，当前代码可能尚未读取
# ============================================================

# Web 管理后台（Phase 2 预留）
# WEB_ADMIN_HOST=127.0.0.1
# WEB_ADMIN_PORT=3000
# WEB_ADMIN_JWT_SECRET=change-me

# 内容安全 API（Phase 2 预留）
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_API_KEY=

# AI 辅助（Phase 3 预留）
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
