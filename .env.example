# ============================================================
# QQ Group Ops 配置模板
#
# 用法：
#   1. 复制为 .env
#      cp .env.example .env
#   2. 按下面注释填写
#   3. 不要把 .env 提交到 Git
#
# 哪些项能热改：
#   · 标了「可 /config 热改」的项，`.env` 里写的只是**默认值**；
#     全局超管可以在私信用 `/config` 改，改完立即生效、不用重启（覆盖值存库里，优先级高于 .env）。
#   · 其余（凭据 / 事件模式 / 数据库 / 日志 / 班级库路径 / 超管种子）是启动就必需的**核心项**，只能改 .env 并重启。
# ============================================================

# ------------------------------------------------------------
# 1. QQ 官方开放平台机器人（必填）
# ------------------------------------------------------------
# 在 QQ 开放平台创建机器人后获取
QQ_BOT_APP_ID=
# 机器人 Client Secret
QQ_BOT_CLIENT_SECRET=
# 可选：已有 access token 时填写；留空则自动获取并缓存（未过期会复用）
QQ_BOT_TOKEN=
# 是否使用沙箱环境（如开放平台提供）
QQ_BOT_SANDBOX=false
# access token 与网关地址缓存文件；留空则只用内存缓存（重启后重新获取）
QQ_BOT_CACHE_FILE=data/qq-bot-cache.json

# ------------------------------------------------------------
# 1b. 事件通道（§D5；默认 WebSocket，无需公网入口）
# ------------------------------------------------------------
# websocket（默认）= 官方 WebSocket 长连接；webhook = 官方回调推送到本服务。
# 两条通道**二选一**，同时开会把同一条事件消费两次。
EVENT_MODE=websocket
# 以下 3 项仅在 EVENT_MODE=webhook 时生效：
# 监听端口（默认 3000，通常由反向代理转发 443 → 本端口）
WEBHOOK_PORT=3000
# 监听地址（默认 127.0.0.1，只让本机反向代理访问；直接暴露时才用 0.0.0.0）
WEBHOOK_HOST=127.0.0.1
# 回调路径（必须与开放平台后台填写的一致）
WEBHOOK_PATH=/webhook/qq
# 回调签名密钥（Ed25519 种子）；留空则复用 QQ_BOT_CLIENT_SECRET（写 `WEBHOOK_SECRET=` 也会回落）
WEBHOOK_SECRET=

# 展示时区：卡片时间 + 日志时间（默认 Asia/Shanghai = UTC+8；库里始终存 UTC）
# 例：TZ=UTC 或 TZ=Asia/Tokyo；非法值会回落到默认并打 warn
# 可 /config 热改（改完立即生效）
TZ=Asia/Shanghai

# ------------------------------------------------------------
# 2. 权限
# ------------------------------------------------------------
# 超级管理员 userId（官方 OpenID / member_openid），逗号分隔，不是 QQ 号
ADMIN_USER_IDS=

# ------------------------------------------------------------
# 3. 数据库（默认 SQLite，无需额外配置）
# ------------------------------------------------------------
# SQLite 数据文件；目录会自动创建
SQLITE_PATH=data/qq-group-ops.db
# 想改用 PostgreSQL 时取消下面两行注释（本地可先执行 pnpm db:up）：
# DATABASE_URL=postgres://qqbot:change-me@localhost:5432/qq_group_ops
# POSTGRES_PASSWORD=change-me
# 其他可选写法：
# DATABASE_URL=sqlite:./data/qq-group-ops.db   # 显式指定 SQLite 文件
# DATABASE_URL=sqlite::memory:                 # 纯内存，重启即丢，仅调试用

# ------------------------------------------------------------
# 4. 入群审核（班级 / 专业库）
# ------------------------------------------------------------
# 班级索引文件；由 `pnpm class:index` 从 data/class.json 生成
CLASS_INDEX_FILE=data/class-index.json
# 仅 `pnpm class:index` 使用：JSON + SQLite 双产物的 SQLite 路径（设 - 跳过）
# CLASS_INDEX_SQLITE_FILE=data/class-index.sqlite

# ------------------------------------------------------------
# 5. 日志
# ------------------------------------------------------------
# debug / info / warn / error
LOG_LEVEL=info
# 日志文件路径；设为空字符串可关闭文件日志
LOG_FILE=logs/qq-group-ops.log
# 是否输出到控制台
LOG_CONSOLE=true
# 彩色显示：auto / always / never
LOG_COLOR=auto

# ------------------------------------------------------------
# 6. 数据保留（-1 = 永久保留，0 = 关闭该能力，正整数 = 天数；本节三项都可 /config 热改）
# ------------------------------------------------------------
# 消息原文（**平台默认值**）：0 = 不保存；-1 = 永久保存；如需短期追溯可设为 3-7
# 保留期按群生效：单个群可用 /rules set rawMessageRetentionDays <天数> 覆盖，没设过的群才用这里；清理也按各群生效值
RAW_MESSAGE_RETENTION_DAYS=0
# 审计日志保留天数（默认 180；-1 = 永久保留）
AUDIT_LOG_RETENTION_DAYS=180
# 待审批入群申请的有效期（天）：超过即标记为 expired（不再出现在 /pending 与推送里，
# 仍可用 /whois 追溯）；0 = 不自动过期，-1 = 永久保留
JOIN_REQUEST_TTL_DAYS=7

# ------------------------------------------------------------
# 7. 交互菜单（/menu）（本节一项可 /config 热改）
# ------------------------------------------------------------
# 私信「首次交互推一次主菜单」的记录方式：
#   persistent = 入库（默认，重启不重复推送）
#   memory     = 只记内存（pnpm dev 默认，重启后可再次验证推送）
# MENU_FIRST_PUSH=persistent

# ------------------------------------------------------------
# 8. 活动通知（/activity 订阅与新活动推送）（本节三项可 /config 热改）
# ------------------------------------------------------------
# 活动通知每人每日上限（非负整数；0 = 不限制，默认 3）。
# 主动私信有官方额度：单用户每天 1000 条、单关系 20 qpm、未认证机器人 5 qps & 30 qpm，
# 且用户可在 QQ 客户端关闭「允许主动发送」；封顶避免一条活动变更通知打满额度。
ACTIVITY_NOTIFY_DAILY_LIMIT=3

# ------------------------------------------------------------
# 活动通知令牌桶速率（正整数；0 = 不限制，默认 5 条/秒）。
# 桶容量按速率向上取整，桶空时排队等待下一个令牌（不丢通知）；官方主动私信也有 qps 限制。
ACTIVITY_NOTIFY_RATE_PER_SECOND=5

# ------------------------------------------------------------
# 申诉值班轮转（§B8）
# ------------------------------------------------------------
# 申诉默认通知所有管理员（群管理员 / 本群超管 / 全局超管），审核员之间轮单：
# 一次只通知一位审核员，超过 APPEAL_HOLD_MINUTES 仍未处理就转给下一位（0 = 不自动转派）。
APPEAL_HOLD_MINUTES=15

# ------------------------------------------------------------
# 9. 活动统计图片（/activity 管理卡的「统计图片」）（本节一项可 /config 热改）
# ------------------------------------------------------------
# 统计图字体下载地址：系统已有中文字体（Windows 雅黑 / Linux Noto CJK）时不会用到；
# 找不到系统字体才从这里下载并缓存到 data/fonts/（gitignored，不随包提交）。
# 留空表示「只用系统字体」，不为统计图下载字体。
# 想出图还需要可选依赖（原生包）：pnpm add @napi-rs/canvas；
# 拿不到依赖或字体 → 统计图降级为文字统计卡，绝不影响启动。
ACTIVITY_STATS_FONT_URL=https://github.com/notofonts/noto-cjk/raw/main/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf

# ------------------------------------------------------------
# 10. 统一计时与部署监测（本节四项可 /config 热改）
# ------------------------------------------------------------
# 统一扫描周期（毫秒，默认 60000）：全项目只跑这一个定时器，
# 保留清理（24h）/ 活动提醒 / 申诉轮转 / 待审批 TTL / 部署监测都由它驱动；0 = 全部关闭。
# SCAN_INTERVAL_MS=60000
# 检测到服务器上的版本变化后自动重启（默认开；0 = 只通知不自动重启）。
# AUTO_RESTART_ON_DEPLOY=1
# 自动重启前的宽限期（分钟，默认 10；0 = 检测到就重启）。
# DEPLOY_RESTART_DELAY_MINUTES=10
# 部署监测的扫描间隔（毫秒，默认 60000；0 = 关闭监测）。
# DEPLOY_CHECK_INTERVAL_MS=60000

# ============================================================
# 11. 管理 API（E1；与机器人**分开**的进程，默认关闭）
# ============================================================
# 认证是「机器人私信一次性令牌 + 会话 cookie」（docs/ADMIN-API.md §1）：
#   ① 管理员私信机器人 /admin login（或服务器上跑 pnpm admin:token）→ 拿一次性令牌
#   ② 浏览器打开 <PUBLIC_BASE_URL>/login?token=…（链接点不动就手工粘贴令牌）
#   ③ 服务端兑换令牌 → 种会话 cookie（HttpOnly + SameSite=Strict）
# 这些属于**核心安全项**，只从环境变量读，不进 /config 热改。
# 生产还必须在前面挂 TLS 反代，并把 COOKIE_SECURE 设成 true。
# ADMIN_API_ENABLED=false
# ADMIN_API_HOST=127.0.0.1
# ADMIN_API_PORT=8787
# 会话 cookie 的 HMAC 密钥，至少 32 字符（换了它 = 所有会话立刻失效）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_API_SESSION_SECRET=
# 会话滑动过期（分钟，默认 720 = 12 小时）
# ADMIN_API_SESSION_TTL_MINUTES=720
# 反代终止 TLS 时设 true（cookie 加 Secure）
# ADMIN_API_COOKIE_SECURE=false
# 浏览器能访问到的管理面地址（留空则 /admin login 只给令牌、需要手工粘贴）
# ADMIN_API_PUBLIC_BASE_URL=https://ops.example.com
# 一次性令牌有效期（分钟，默认 10）
# ADMIN_API_TOKEN_TTL_MINUTES=10
# 额外收窄可签发令牌的人（留空 = 所有平台超管 240）
# ADMIN_API_ALLOWED_OPENIDS=
# 每个会话每分钟的请求上限（0 = 不限）
# ADMIN_API_RATE_LIMIT_PER_MINUTE=60

# ============================================================
# 以下为后续阶段预留，当前代码可能尚未读取
# ============================================================

# 内容安全 API（Phase 2 预留）
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_API_KEY=

# AI 辅助（Phase 3 预留）
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
