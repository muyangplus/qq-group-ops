# QQ 官方开放平台机器人配置
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
QQ_BOT_TOKEN=
QQ_BOT_SANDBOX=false

# 数据库
DATABASE_URL=postgresql+asyncpg://qqbot:change-me@localhost:5432/qq_group_guard

# 管理员 QQ 号（逗号分隔；Phase 1 会改为更严格的权限模型）
ADMIN_QQ_IDS=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 数据保留策略
# 0 表示不保存消息原文
RAW_MESSAGE_RETENTION_DAYS=0
AUDIT_LOG_RETENTION_DAYS=180
