{
  "name": "qq-group-ops",
  "version": "0.27.2",
  "description": "基于 QQ 官方开放平台 API 的开源 QQ 群管理与运营平台：群管、审核、活动报名、信息导出",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:audit": "pnpm audit --audit-level=high",
    "db:up": "docker compose --profile postgres up -d db",
    "class:index": "node scripts/build-class-index.mjs",
    "start": "node dist/main.js",
    "admin:api": "node dist/adminApi/main.js",
    "admin:token": "node dist/adminApi/cliToken.js",
    "web:install": "pnpm --dir web install",
    "web:dev": "pnpm --dir web run dev",
    "web:build": "pnpm --dir web run build",
    "web:test": "pnpm --dir web run test",
    "web:typecheck": "pnpm --dir web run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  }
}
